[TEMPLATE]
# Copy to .env and fill in what you need.

# GPTZero AI detection (optional — without it, local heuristics or LM Studio are used):
GPTZERO_API_KEY=

# 1 = seed demo data on first run (default; good for local demos).
# 0 = production: no demo data is seeded.
TURNITOUT_DEMO=1

# Writing enhancer via local LM Studio (optional — without it, offline rules are used):
# LMSTUDIO_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_EXPERT=
# LMSTUDIO_BASE=

# Docker Compose only: your public domain for Caddy automatic HTTPS.
# DOMAIN=turnitout.example.com
