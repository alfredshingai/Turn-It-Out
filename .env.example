# Copy to .env and fill in what you need.

# GPTZero AI detection (optional — without it, local heuristics are used):
GPTZERO_API_KEY=

# 1 = seed demo accounts & sample data on first run (default; good for local demos).
# 0 = production: the first instructor to register bootstraps the instance.
TURNITOUT_DEMO=1

# Set to 1 when running behind an HTTPS reverse proxy (Caddy/nginx/PaaS)
# so session cookies get the Secure flag.
TURNITOUT_TRUST_PROXY=0

# Docker Compose only: your public domain for Caddy automatic HTTPS.
# DOMAIN=turnitout.example.com
